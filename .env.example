# =============================================================================
# UnityWorks Vision AI — frontend environment
#
# Copy to .env.local for development. Everything here is PUBLIC: Vite inlines
# VITE_* variables into the bundle, where anyone can read them.
#
# NEVER put here: JWT secrets, database passwords, NVIDIA keys, RTSP passwords,
# refresh tokens, or any other credential. The frontend holds no secrets by
# design — the access token lives in memory for one session, and the refresh
# token is an httpOnly cookie the page cannot read.
# =============================================================================

# Same-origin by default, which is REQUIRED rather than merely tidy: the refresh
# cookie is SameSite=Strict, so a cross-origin frontend never has it attached and
# every session silently fails to restore. In development Vite proxies /api and
# /ws to the backend; in production both sit behind one origin.
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/ws/v1/live

VITE_ENVIRONMENT=development

# Shows the DevTools entry in navigation. The REAL gate is the backend:
# FEATURE_DEVTOOLS must be on and the account must hold `access_devtools`.
# Turning this on without those changes nothing except an extra 403.
VITE_FEATURE_DEVTOOLS=true
