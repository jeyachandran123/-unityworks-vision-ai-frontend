{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "@testing-library/jest-dom"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // No "baseUrl". It is deprecated and stops functioning in TypeScript 7.0,
    // and since TypeScript 4.1 "paths" has not needed it: a mapping that is not
    // absolute resolves relative to THIS file, which is what the entries below
    // now say explicitly.
    //
    // Removed rather than silenced with "ignoreDeprecations": "6.0", because
    // that only buys time — the option still disappears in 7.0. Nothing here
    // depended on it: every alias import uses an "@" prefix, and Vite resolves
    // the same five aliases itself in vite.config.ts, so the two stay in step.
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@shared/*": ["./src/shared/*"],
      "@features/*": ["./src/features/*"],
      "@devtools/*": ["./src/devtools/*"]
    }
  },
  "include": ["src", "tests"]
}
